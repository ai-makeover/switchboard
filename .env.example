# Names only. Put real values in Railway's Variables tab, never in this file or a commit.

# Who may sign in. Comma-separated Google account emails. Everyone else is refused and gets no token.
ALLOWED_EMAILS=

# Google OAuth client (Google Cloud console > Credentials > OAuth client ID > Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Long random string (64+ chars). Signs tokens, the confirm-page session and encrypts OAuth storage.
# The Railway template generates it for you.
SWITCHBOARD_SECRET=

# Unipile. v1 = your DSN (e.g. https://apiNN.unipile.com:PORT). v2 = https://api.unipile.com
UNIPILE_API_VERSION=v1
UNIPILE_API_BASE=
UNIPILE_API_KEY=

# Channels: whatsapp, linkedin, instagram. Start with whatsapp.
ENABLED_CHANNELS=whatsapp

# Unipile account ids. On v1 these are optional when exactly one account of that type is connected.
# On v2 they're required (Dashboard > Accounts).
WHATSAPP_ACCOUNT_ID=
LINKEDIN_ACCOUNT_ID=
INSTAGRAM_ACCOUNT_ID=

# Optional. Defaults to https://$RAILWAY_PUBLIC_DOMAIN on Railway.
BASE_URL=

# Optional. Where drafts and OAuth state live. Mount a Railway volume here.
DATA_DIR=/data

# Optional pacing overrides (defaults: WhatsApp 40 s gap, 20/hour, 30/day; LinkedIn and Instagram 60 s, 10/hour, 50/day).
# WHATSAPP_MIN_GAP_SECONDS=
# WHATSAPP_SENDS_PER_HOUR=
# WHATSAPP_SENDS_PER_DAY=
# DRAFTS_PER_HOUR=
